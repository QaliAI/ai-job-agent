# AI Job Agent - Privacy & Security Git Ignore

# ==========================================
# 1. CANDIDATE PERSONAL DATA & PROFILES
# NEVER COMMIT YOUR REAL RESUME OR PERSONAL DETAILS
# ==========================================
candidate/MASTER_PROFILE.md
candidate/SEARCH_PREFERENCES.md
candidate/VERIFIED_ACHIEVEMENTS.md
candidate/CAREER_STORIES.md
candidate/skills.json
candidate/*.pdf
candidate/*.docx
candidate/*.txt
candidate/*.md
!candidate/README.md

# ==========================================
# 2. RUNTIME OUTPUTS & GENERATED MATERIALS
# NEVER COMMIT TAILORED RESUMES OR APPLICATION LETTERS
# ==========================================
output/*
!output/.gitkeep
output/**/*.pdf
output/**/*.docx
output/**/*.md
output/**/*.json

# ==========================================
# 3. RUNTIME JOB STORES & HISTORY LEDGER
# ==========================================
jobs/*
!jobs/.gitkeep
jobs/seen.json
jobs/history.json
jobs/found-*.json
jobs/scored-*.json

# ==========================================
# 4. SECRETS, CREDENTIALS & ENVIRONMENT
# ==========================================
.env
.env.*
*.env
*.pem
*.key
*.token
credentials.json
secrets.json

# ==========================================
# 5. PYTHON & SYSTEM ARTIFACTS
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 6. NODE & JAVASCRIPT
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 7. OS & IDE TEMPORARIES
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
